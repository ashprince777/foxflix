{
  "name": "foxflix",
  "version": "1.0.0",
  "description": "Local video streaming app",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "Foxora Digital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashprince777/foxflix.git"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "bonjour-service": "^1.3.0",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "mime-types": "^2.1.35",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.foxoradigital.foxflix",
    "productName": "FoxFlix",
    "publish": [
      {
        "provider": "github",
        "owner": "ashprince777",
        "repo": "foxflix"
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "forceCodeSigning": false,
    "icon": "public/logo.ico",
    "win": {
      "icon": "public/logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/logo.ico",
      "uninstallerIcon": "public/logo.ico",
      "uninstallDisplayName": "FoxFlix"
    },
    "files": [
      "**/*",
      "!movies/*"
    ]
  }
}
